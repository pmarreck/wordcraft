# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime = Exact-commit CI target manifest for all platform builds and native checks
	Cargo.lock = Pinned Cargo dependency graph
	Cargo.toml = Authoritative Rust workspace graph, versions, and compilation profiles
	INTENT.md = Upstream product purpose and fork-specific build and web outcomes
	PLAN.md = Current fork work and recent build, browser storage and deployment completions
	apps = Native desktop app, command-line tools, and WASM frontend
	apps/wordcraft-web/src/browser_storage.rs = localStorage adapter and exclusive Web Locks with recoverable browser errors
	assets = Original and openly licensed icons, fonts, and proofing resources
	build = Check daily upstream rebase freshness, then publish a native Nix build
	build-all = Build all five OS and architecture targets and report failures
	contributors = Contributor identities and generated About-window credits
	crates = Rust libraries from document primitives through the editor frontend
	crates/ui-egui/src/browser_documents.rs = Lossless browser library, locked revision checks, confirmed saves and clean stale-tab reload
	crates/ui-egui/src/browser_documents_tests.rs = Storage, pending-save, cross-tab and scripted-download confirmation regressions
	docs = Architecture, compatibility assessments, protocols, and development documentation
	docs/PLAN_LOG.md = Completed plan items retired verbatim with completion evidence
	docs/browser-storage.md = Browser open/save/import/export usage, persistence limits and command interface
	flake.lock = Exact revisions and content hashes for the Nix toolchain inputs
	flake.nix = Pinned Nix packages, development shells, full checks, and five build targets
	nix = Nix packaging of the Cargo workspace and platform runtime dependencies
	nix/browser-test.nix = Pinned Chromium WebDriver and OCR environment for real-browser persistence checks
	nix/package.nix = Crane builds, machine-header gates, runtime libraries and complete platform products
	nix/web.nix = Offline pinned Cargo, Trunk and wasm-bindgen build of the static browser editor
	nix/windows-toolchain.nix = ARM64 MinGW pthread resource-header workaround for the pinned Nixpkgs
	packaging = Desktop installers, application bundles, and web release packaging
	scripts = Shared build helpers for safe updates and target-separated publication
	scripts/build-common.sh = Daily sync cache, safe upstream rebase and atomic target publication
	test = Complete Nix-sandboxed test and quality-gate entrypoint
	tests = Build-script and application CLI regression suites
	tests/cli/apps = Headless checks of installed app help, version and about flags
	tests/cli/browser-storage = Chromium persistence, two-tab conflicts and actual local-file import/export
	tests/cli/build-scripts = CLI, real Git rebase and atomic publication regression tests
	tests/cli/macos-signature = Verify the complete native macOS app bundle with Apple codesign
	tests/cli/package-headers = Check final installed executables and launchers against the target machine architecture
	tests/cli/upstream-sync = Daily upstream sync regression tests with real local Git and an injected clock
	tests/cli/web-assets = Validate the generated WASM site and project-relative asset URLs
	xtask = Cargo quality gates, parity reports, and repository maintenance
]
