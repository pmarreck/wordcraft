#!/usr/bin/env bash
# Sourced by browser-storage with WORDCRAFT_BROWSER_MOBILE=1; uses its real WebDriver session.
# shellcheck disable=SC2154
locate '^Print Layout' >/dev/null || exit 1
touch_drag() {
	wd POST "/session/$session/actions" "$(jq -cn --argjson x "$1" --argjson y "$2" --argjson tx "$3" --argjson ty "$4" '{actions:[{type:"pointer",id:"finger",parameters:{pointerType:"touch"},actions:[{type:"pointerMove",duration:0,x:$x,y:$y},{type:"pointerDown",button:0},{type:"pointerMove",duration:350,x:$tx,y:$ty},{type:"pointerUp",button:0}]}]}')" >/dev/null || exit 1
}
touch_tap() {
	wd POST "/session/$session/actions" "$(jq -cn --argjson x "$1" --argjson y "$2" '{actions:[{type:"pointer",id:"finger",parameters:{pointerType:"touch"},actions:[{type:"pointerMove",duration:0,x:$x,y:$y},{type:"pointerDown",button:0},{type:"pointerUp",button:0}]}]}')" >/dev/null || exit 1
}
wheel_scroll() {
	# ChromeDriver tries to convert wheel actions into invalid touch events in mobile mode.
	wd POST "/session/$session/goog/cdp/execute" "$(jq -cn --argjson x "$1" --argjson y "$2" '{cmd:"Input.dispatchMouseEvent",params:{type:"mouseMoved",x:$x,y:$y}}')" >/dev/null || exit 1
	wd POST "/session/$session/goog/cdp/execute" "$(jq -cn --argjson x "$1" --argjson y "$2" --argjson delta "$3" '{cmd:"Input.dispatchMouseEvent",params:{type:"mouseWheel",x:$x,y:$y,deltaX:0,deltaY:$delta}}')" >/dev/null || exit 1
}
pinch() {
	wd POST "/session/$session/actions" '{"actions":[{"type":"pointer","id":"left","parameters":{"pointerType":"touch"},"actions":[{"type":"pointerMove","duration":0,"x":145,"y":450},{"type":"pointerDown","button":0},{"type":"pointerMove","duration":400,"x":95,"y":410},{"type":"pointerUp","button":0}]},{"type":"pointer","id":"right","parameters":{"pointerType":"touch"},"actions":[{"type":"pointerMove","duration":0,"x":245,"y":450},{"type":"pointerDown","button":0},{"type":"pointerMove","duration":400,"x":295,"y":410},{"type":"pointerUp","button":0}]}]}' >/dev/null || exit 1
}
focus_trace_id=0
focus_events() {
	# Chromium's event trace observes real DOM focus/blur, including blur/refocus with
	# the same final active element. Reading activeElement alone misses keyboard reopening.
	local response deadline=$((SECONDS + 10)) marker
	focus_trace_id=$((focus_trace_id + 1))
	marker="wordcraft-focus-$focus_trace_id"
	wd POST "/session/$session/goog/cdp/execute" "$(jq -cn --arg marker "$marker" '{cmd:"Tracing.recordClockSyncMarker",params:{syncId:$marker}}')" >/dev/null || exit 1
	: > "$work/focus-trace.jsonl"
	while ((SECONDS < deadline)); do
		response=$(wd POST "/session/$session/log" '{"type":"performance"}') || exit 1
		jq -c '.value[].message | fromjson | .message | select(.method=="Tracing.dataCollected") | .params' <<<"$response" >> "$work/focus-trace.jsonl"
		if jq -e --arg marker "$marker" 'select(.name=="clock_sync" and .args.sync_id==$marker)' "$work/focus-trace.jsonl" >/dev/null; then
			jq -r 'select(.name=="EventDispatch") | .args.data.type | select(.=="focus" or .=="blur")' "$work/focus-trace.jsonl"
			return 0
		fi
	done
	fail 'browser focus trace did not reach its completion marker'
}
ime_input_value() {
	local response input
	response=$(wd POST "/session/$session/element" '{"using":"css selector","value":"#wordcraft_canvas + input[type=text]"}') || exit 1
	input=$(jq -er '.value["element-6066-11e4-a52e-4f735466cecf"]' <<<"$response") || fail 'browser text input'
	wd GET "/session/$session/element/$input/property/value" | jq -er '.value'
}
export_mobile() {
	local deadline file
	click_label 'word:File'
	click_label '^Save As'
	click_label '^Export to your computer'
	deadline=$((SECONDS + 30))
	while ((SECONDS < deadline)); do
		for file in "$work/downloads/"*.docx; do
			if [[ -f $file ]] && unzip -p "$file" word/document.xml > "$work/mobile-export.xml" 2>/dev/null; then return 0; fi
		done
	done
	fail 'mobile document export'
}
check_mobile_text() {
	# An external file oracle checks every paragraph, not just markers visible on the screen.
	sed -E 's#</w:p>#\n#g; s#<[^>]*>##g' "$work/mobile-export.xml" | sed '/^$/d' > "$work/mobile-export.txt"
	cmp "$1" "$work/mobile-export.txt" || fail 'exported writing differs from the imported file'
}
mobile_fixture="$work/mobile-input.txt"
printf '%s\n' 'The quick brown fox jumps over the lazy dog.' 'Start of document marker' > "$mobile_fixture"
for ((i=1;i<=80;i++)); do printf 'Paragraph %d: Mobile swipes preserve this writing.\n' "$i" >> "$mobile_fixture"; done
wd POST "/session/$session/goog/cdp/execute" '{"cmd":"Page.setInterceptFileChooserDialog","params":{"enabled":true}}' >/dev/null || exit 1
shortcut o
click_label '^Import from your computer'
response=$(wd POST "/session/$session/element" '{"using":"css selector","value":"input[type=file]"}') || exit 1
element=$(jq -er '.value["element-6066-11e4-a52e-4f735466cecf"]' <<<"$response") || fail 'mobile file input'
wd POST "/session/$session/element/$element/value" "$(jq -cn --arg text "$mobile_fixture" '{text:$text}')" >/dev/null || exit 1
locate 'word:quick' >/dev/null || exit 1
save_named 'Mobile proof'
shortcut a
focus_events > /dev/null
touch_drag 190 650 190 350
focus_events > "$work/scroll-focus-events.txt"
[[ ! -s $work/scroll-focus-events.txt ]] || fail "scrolling must not reopen the keyboard: $(tr '\n' ' ' < "$work/scroll-focus-events.txt")"
locate 'Paragraph [2-9]' >/dev/null || exit 1
focus_events > /dev/null
wd POST "/session/$session/goog/cdp/execute" '{"cmd":"Input.dispatchTouchEvent","params":{"type":"touchStart","touchPoints":[{"x":190,"y":650}]}}' >/dev/null || exit 1
wd POST "/session/$session/goog/cdp/execute" '{"cmd":"Input.dispatchTouchEvent","params":{"type":"touchCancel","touchPoints":[]}}' >/dev/null || exit 1
focus_events > "$work/cancel-focus-events.txt"
[[ ! -s $work/cancel-focus-events.txt ]] || fail 'a canceled touch must not reopen the keyboard'
printf 'ok: document scrolling does not blur or refocus browser text input\n'
# Both ribbon rows remain browsable. Drags that begin on text fields must scroll too.
read -r x tab_y < <(locate 'word:Home') || fail 'Home tab'
touch_drag 350 "$tab_y" 30 "$tab_y"
read -r x y < <(locate 'word:View') || fail 'swipe to View tab'
touch_tap "$x" "$y"
locate 'word:Views' >/dev/null || exit 1
touch_drag 30 "$tab_y" 350 "$tab_y"
read -r x y < <(locate 'word:Home') || fail 'swipe back to Home tab'
touch_tap "$x" "$y"
read -r font_x font_y < <(locate 'word:Aptos') || fail 'font field'
touch_drag "$font_x" "$font_y" "$((font_x - 60))" "$font_y"
read -r moved_x _ < <(locate 'word:Aptos') || fail 'font field after scrolling'
((moved_x < font_x - 40)) || fail 'drag over font field did not scroll ribbon groups'
printf 'ok: ribbon tabs and groups scroll independently by touch, including over text fields\n'
# A mouse attached to a narrow screen can browse both rows with its ordinary wheel.
wheel_scroll "$moved_x" "$font_y" -140
read -r returned_x _ < <(locate 'word:Aptos') || fail 'font field after wheel up'
((returned_x > moved_x + 40)) || fail 'vertical wheel did not pan command groups back'
wheel_scroll 200 "$tab_y" 320
locate 'word:View' >/dev/null || exit 1
wheel_scroll 200 "$tab_y" -320
locate 'word:Home' >/dev/null || exit 1
printf 'ok: ordinary mouse wheel pans ribbon tabs and command groups sideways\n'
touch_drag 190 650 190 350
locate 'Paragraph [2-9]' >/dev/null || exit 1
focus_events > /dev/null
pinch
focus_events > "$work/pinch-focus-events.txt"
[[ ! -s $work/pinch-focus-events.txt ]] || fail 'pinching must not reopen the keyboard'
screenshot
[[ -z ${WORDCRAFT_BROWSER_EVIDENCE:-} ]] || cp "$work/screen.png" "$WORDCRAFT_BROWSER_EVIDENCE"
export_mobile
check_mobile_text "$mobile_fixture"
printf 'ok: real mobile swipe and two-finger pinch preserve exported writing\n'
# Return to the same saved document at readable zoom before selecting a known word.
shortcut o
locate '^Browser documents$' >/dev/null || exit 1
click_label '^Mobile proof$'
click_label '^Print Layout'
click_label '^Web Layout'
locate 'word:quick' >/dev/null || exit 1
read -r x y width < <(awk -F '\t' -v ratio="$screenshot_ratio" '$1==5 && $12=="quick" {print int($7/ratio), int(($8+$10/2)/ratio), int($9/ratio); exit}' "$work/screen.tsv") || fail 'quick word bounds'
[[ -n ${x:-} && -n ${width:-} ]] || fail 'OCR word bounds'
focus_events > /dev/null
wd POST "/session/$session/actions" "$(jq -cn --argjson x "$x" --argjson y "$y" --argjson end "$((x + width + 1))" '{actions:[{type:"pointer",id:"finger",parameters:{pointerType:"touch"},actions:[{type:"pointerMove",duration:0,x:$x,y:$y},{type:"pointerDown",button:0},{type:"pointerUp",button:0},{type:"pause",duration:100},{type:"pointerDown",button:0},{type:"pointerMove",duration:350,x:$end,y:$y},{type:"pointerUp",button:0}]}]}')" >/dev/null || exit 1
focus_events > "$work/tap-focus-events.txt"
[[ -s $work/tap-focus-events.txt ]] || fail 'completed tap must activate browser text input; the focus trace must observe it'
type_text 'SLOW'
locate 'The SLOW brown fox' >/dev/null || exit 1
browser_ime=$(ime_input_value) || fail 'read browser composition before tapping'
[[ $browser_ime == *SLOW* ]] || fail 'typing must leave observable browser composition state before the tap'
read -r x y < <(locate 'word:brown') || fail 'new insertion point'
touch_tap "$x" "$y"
browser_ime=$(ime_input_value) || fail 'read browser composition after tapping'
[[ -z $browser_ime ]] || fail 'a completed tap must clear stale browser composition state'
printf 'ok: a completed tap clears stale browser composition state\n'
rm -f "$work/downloads/"*.docx
export_mobile
sed '1s/quick/SLOW/' "$mobile_fixture" > "$work/selection-expected.txt"
check_mobile_text "$work/selection-expected.txt"
printf 'ok: real tap-then-drag selects the intended word and typing replaces only that range\n'
# Rotate, then simulate the reduced viewport available with a software keyboard.
for dimensions in '844 390' '390 420' '768 1024' '390 844'; do
	read -r width height <<<"$dimensions"
	wd POST "/session/$session/goog/cdp/execute" "$(jq -cn --argjson width "$width" --argjson height "$height" '{cmd:"Emulation.setDeviceMetricsOverride",params:{width:$width,height:$height,deviceScaleFactor:2,mobile:true}}')" >/dev/null || exit 1
	locate '^Print Layout' >/dev/null || exit 1
	if [[ -n ${WORDCRAFT_BROWSER_EVIDENCE:-} ]]; then
		screenshot
		cp "$work/screen.png" "${WORDCRAFT_BROWSER_EVIDENCE%.png}-${width}x${height}.png"
	fi
done
screenshot
[[ -z ${WORDCRAFT_BROWSER_EVIDENCE:-} ]] || cp "$work/screen.png" "$WORDCRAFT_BROWSER_EVIDENCE"
printf 'ok: landscape, keyboard-sized and tablet viewports keep compact controls reachable\n'
